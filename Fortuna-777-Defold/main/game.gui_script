local rules=require("main.rules")
local C={gold=vmath.vector4(1,.76,.25,1),white=vmath.vector4(1,.96,.84,1),green=vmath.vector4(.035,.21,.13,1),dark=vmath.vector4(.025,.055,.045,1),red=vmath.vector4(.64,.12,.08,1)}
local names={cherry="CEREJA",lemon="LIMAO",orange="LARANJA",grape="UVAS",bell="SINO",star="ESTRELA",seven="7"}
local colors={cherry=vmath.vector4(.9,.18,.22,1),lemon=vmath.vector4(.9,.73,.13,1),orange=vmath.vector4(1,.48,.16,1),grape=vmath.vector4(.65,.37,.9,1),bell=C.gold,star=C.gold,seven=C.red}
local function box(x,y,w,h,color)
 local n=gui.new_box_node(vmath.vector3(x,y,0),vmath.vector3(w,h,0))
 gui.set_color(n,color)
 return n
end
local function label(x,y,t,s,color)
 local n=gui.new_text_node(vmath.vector3(x,y,0),t)
 gui.set_font(n,"default")
 gui.set_scale(n,vmath.vector3(s,s,1))
 gui.set_color(n,color or C.white)
 return n
end
local function button(x,y,w,t)
 local n=box(x,y,w,54,C.gold)
 box(x,y,w-6,48,C.green)
 local l=label(x,y,t,1.3,C.gold)
 return {n=n,l=l}
end
local function draw_col(self,col,grid)
 for row=1,3 do
  local id=grid[row][col]
  local n=self.cells[row][col]
  gui.play_flipbook(n,id)
  gui.set_position(n,vmath.vector3(220+(col-1)*260,350-(row-1)*82,0))
  gui.set_scale(n,vmath.vector3(1,1,1))
 end
end
local function refresh(self)
 gui.set_text(self.balance_label,"CREDITOS: "..self.balance)
 gui.set_text(self.bet.l,"APOSTA: "..self.amount)
 gui.set_text(self.lines.l,"LINHAS: "..self.active)
 gui.set_text(self.win_label,"PREMIO: "..self.last)
end
local function clear_lines(self)
 for _,n in ipairs(self.highlights) do gui.delete_node(n) end
 self.highlights={}
end
local function show_lines(self)
 for _,w in ipairs(self.pending.result.lineWins) do
  local path=rules.lines[w.line]
  for col=1,2 do
   local x1=220+(col-1)*260
   local y1=350-(path[col]-1)*82
   local x2=x1+260
   local y2=350-(path[col+1]-1)*82
   local dx,dy=x2-x1,y2-y1
   local n=box((x1+x2)/2,(y1+y2)/2,math.sqrt(dx*dx+dy*dy),4,vmath.vector4(1,.77,.25,.85))
   gui.set_rotation(n,vmath.vector3(0,0,math.deg(math.atan2(dy,dx))))
   self.highlights[#self.highlights+1]=n
  end
  for col=1,3 do
   local x=220+(col-1)*260
   local y=350-(path[col]-1)*82
   self.highlights[#self.highlights+1]=box(x,y-33,80,4,C.gold)
  end
 end
end
local function spin(self)
 if self.pending then return end
 if self.balance<self.amount*self.active then gui.set_text(self.status,"SEM CREDITOS VIRTUAIS"); return end
 clear_lines(self)
 if not self.music_started then
  sound.play("/game#music",{gain=.25})
  self.music_started=true
 end
 self.pending=rules.spin(self.amount,self.active)
 self.balance=self.balance-self.pending.cost
 self.last=0
 self.elapsed=0
 self.next_frame=0
 self.reel_tick={0,0,0}
 self.reel_phase={0,0,0}
 self.visual_stops={math.random(20),math.random(20),math.random(20)}
 self.stopped=0
 gui.set_text(self.status,"A RODAR")
 refresh(self)
end
function init(self)
 msg.post(".","acquire_input_focus")
 math.randomseed(os.time())
 self.balance=500;self.amount=1;self.active=5;self.last=0;self.highlights={};self.cells={{},{},{}}
 box(480,270,960,540,C.dark)
 box(480,270,920,510,C.green)
 label(480,500,"FORTUNA 777",2.8,C.gold)
 label(480,472,"DEFOLD V6.2 | CREDITOS VIRTUAIS",.9,C.white)
 box(480,270,820,272,C.gold)
 box(480,270,810,262,C.dark)
 for col=1,3 do
  for row=1,3 do
   local x=220+(col-1)*260; local y=350-(row-1)*82
   box(x,y,246,76,C.gold)
   box(x,y,240,70,C.white)
   box(x,y,232,62,vmath.vector4(.88,.84,.72,1))
   for stripe=1,15 do
    local offset=(stripe-8)*4
    local v=1-.30*(math.abs(offset)/30)^1.7
    box(x,y+offset,232,4,vmath.vector4(.88*v,.84*v,.72*v,1))
   end
   local n=box(x,y,74,74,vmath.vector4(1,1,1,1))
   gui.set_texture(n,"symbols")
   self.cells[row][col]=n
  end
 end
 self.balance_label=label(240,128,"",1.25)
 self.win_label=label(720,128,"",1.25,C.gold)
 self.status=label(480,105,"PRONTO",1,C.gold)
 self.bet=button(145,55,190,"APOSTA")
 self.lines=button(358,55,190,"LINHAS")
 self.spin=button(680,55,380,"RODAR")
 local grid=rules.grid({1,2,3})
 for col=1,3 do draw_col(self,col,grid) end
 refresh(self)
end
function update(self,dt)
 if not self.pending then return end
 self.elapsed=self.elapsed+dt
 for col=self.stopped+1,3 do
  local stop_at=.65+(col-1)*.35
  local remaining=math.max(0,stop_at-self.elapsed)
  local speed=5+12*math.min(1,remaining/.40)
  self.reel_phase[col]=self.reel_phase[col]+dt*speed
  while self.reel_phase[col]>=1 do
   self.reel_phase[col]=self.reel_phase[col]-1
   self.visual_stops[col]=(self.visual_stops[col]%20)+1
   draw_col(self,col,rules.grid(self.visual_stops))
  end
  local phase=self.reel_phase[col]
  local squash=1-.20*math.sin(math.pi*phase)
  for row=1,3 do
   gui.set_scale(self.cells[row][col],vmath.vector3(1,squash,1))
  end
 end
 while self.stopped<3 and self.elapsed>=.65+self.stopped*.35 do
  self.stopped=self.stopped+1
  draw_col(self,self.stopped,self.pending.grid)
  sound.play("/game#stop",{gain=.85})
  for row=1,3 do
   local n=self.cells[row][self.stopped]
   gui.set_scale(n,vmath.vector3(1,.85,1))
   gui.animate(n,gui.PROP_SCALE,vmath.vector3(1,1,1),gui.EASING_OUTBACK,.14)
  end
 end
 if self.stopped==3 then
  self.last=self.pending.result.total
  self.balance=self.balance+self.last
  show_lines(self)
  if self.last>0 then sound.play("/game#win",{gain=.8}) end
  gui.set_text(self.status,self.last>0 and "PREMIO" or "PRONTO")
  self.pending=nil
  refresh(self)
 end
end
function on_input(self,id,action)
 if id~=hash("touch") then return end
 if not action.pressed then return end
 if self.pending then return true end
 if gui.pick_node(self.spin.n,action.x,action.y) then spin(self)
 elseif gui.pick_node(self.bet.n,action.x,action.y) then self.amount=self.amount%10+1;refresh(self)
 elseif gui.pick_node(self.lines.n,action.x,action.y) then self.active=self.active==5 and 1 or self.active+2;refresh(self)
 else return end
 return true
end
